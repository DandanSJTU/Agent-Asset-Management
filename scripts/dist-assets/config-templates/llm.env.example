# ============================================================
# LLM 配置（由 install.sh 生成到 runtime/config/llm.env，真实值不入库）
#
# 两份 LLM 配置互相独立，都要填：
#   ① memory 组 → MemoryCore 用：记忆抽取（L1）、场景归纳（L2）、画像（L3）、技能提炼
#   ② knowledge 组 → MemoryKnowledge 用：Wiki / Code-Graph 文档抽取
# 只填一处，另一处会报 "Failed to parse URL from REPLACE_ME/chat/completions"
# ============================================================

# ── memory 组（MemoryCore，端口 8420）──
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-REPLACE_ME
LLM_MODEL=deepseek-chat

# promptMode：code（代码工程/团队协作，默认）| chat（个人对话/教学）
# 配错的表现是"聊了很久没抽出记忆"，换一个再试
PROMPT_MODE=code

# ── knowledge 组（MemoryKnowledge，端口 8424）──
# 通常与 memory 组填一样即可
KNOWLEDGE_LLM_BASE_URL=https://api.deepseek.com/v1
KNOWLEDGE_LLM_API_KEY=sk-REPLACE_ME
KNOWLEDGE_LLM_MODEL=deepseek-chat

# ── proxy 上游（MemoryProxy，端口 8096）──
# coding agent 的请求转发目标；不打算接 Claude Code 之类可留占位
PROXY_UPSTREAM_URL=https://api.deepseek.com/v1
PROXY_UPSTREAM_API_KEY=sk-REPLACE_ME
